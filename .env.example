APP_ENV=production
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_SAFETY_MODEL=
NVIDIA_REASONING_FALLBACK_MODEL=
NVIDIA_FAST_FALLBACK_MODEL=
NVIDIA_REQUEST_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=3
# JSON mapping model IDs to supported additional request parameters only.
NVIDIA_MODEL_PARAMETERS={"nvidia/nemotron-3-super-120b-a12b":{"reasoning_effort":"low","reasoning_budget":4096},"nvidia/nemotron-3-nano-omni-30b-a3b-reasoning":{"reasoning_budget":512}}
NVIDIA_EMBEDDING_DIMENSION=2048
NVIDIA_EMBEDDING_BATCH_SIZE=16
AI_USAGE_MODE=quota
ENABLE_NVIDIA_SAFETY=false
ENABLE_VISION=true
ENABLE_RERANKING=true
LOW_MEMORY_MODE=true
# Supabase direct connection or session pooler URL. URL-encode special password characters.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional replacement CA; the public Supabase Root 2021 CA is bundled by default.
# DATABASE_SSL_CA_FILE=backend/certs/prod-supabase.cer
DATABASE_POOL_SIZE=3
# Optional Data API diagnostics. These do not replace DATABASE_URL or its database password.
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=50
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=8192
DEMO_MODE=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=true
ALLOWED_ORIGINS=["http://localhost"]
UPLOAD_DIR=/data/uploads
PUBLIC_PORT=80
